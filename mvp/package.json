{
  "name": "weave-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "Weave S#5·6 태블릿 ↔ XR뷰 연동 MVP (로컬 LAN 전용)",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "vite build && node server/index.js --prod",
    "test": "node --test test/*.test.js",
    "pano:prep": "node scripts/prep-pano.mjs",
    "pano:clean": "node -e \"require('fs').rmSync('assets/pano/built',{recursive:true,force:true});console.log('assets/pano/built 삭제 완료 (npm run pano:prep으로 다시 만들 수 있음)')\"",
    "ui:fetch": "node scripts/fetch-figma-assets.mjs",
    "docs:scenario": "node scripts/scenario-doc.mjs"
  },
  "dependencies": {
    "pretendard": "^1.3.9",
    "qrcode-terminal": "^0.12.0",
    "sirv": "^3.0.2",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^8.3.2"
  }
}
